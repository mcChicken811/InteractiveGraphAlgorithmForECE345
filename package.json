{
  "name": "bfs-graph-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && rolldown -c rolldown.config.mjs",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & rolldown -c rolldown.config.mjs --watch",
    "serve": "node scripts/static-server.mjs",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "sh scripts/e2e-docker.sh",
    "test:e2e:local": "playwright test",
    "test:all": "vitest run && sh scripts/e2e-docker.sh",
    "icons": "node scripts/render-favicons.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^26.6.6",
    "happy-dom": "^21.0.4",
    "rolldown": "1.2.19",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}

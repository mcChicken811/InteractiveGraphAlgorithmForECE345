{
  // Type-checks everything (app, tests, configs). `npm run typecheck`
  "compilerOptions": {
    "target": "ES2022",
    // NodeNext enforces explicit ".js" import extensions (rolldown.config.mjs resolves
    // them to the .ts files when it bundles src/ into build/app.js).
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src", "unit_tests", "tests", "vitest.config.ts", "playwright.config.ts"]
}
